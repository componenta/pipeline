{
    "name": "componenta/pipeline",
    "description": "PSR-15 middleware pipeline for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^1.0 || ^2.0.2 || ^3.0 || ^4.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max --no-progress",
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate",
        "check": [
            "@test",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": {
                "doctrine/annotations": "Transitive PHPBench development dependency; benchmarks use PHP attributes. Security advisories remain enforced."
            }
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Middleware\\PipelineConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-fix/pipeline-audit": "1.1.x-dev",
            "dev-main": "1.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
